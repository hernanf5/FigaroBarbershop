@model FigaroBarbershop.Models.LoginView
@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Iniciar sesión";
    ViewData["NavSolido"] = true;
}

<section style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:120px 24px 60px;">
    <div style="background:var(--bg2); border:1px solid var(--rule); width:100%; max-width:440px; padding:48px 40px;">
        <div class="label" style="margin-bottom:16px; text-align:center;">Acceso al panel</div>
        <h1 style="font-family:var(--serif); font-weight:300; font-size:40px; text-align:center; margin-bottom:36px;">
            Iniciar <em>sesión</em>
        </h1>

        <div asp-validation-summary="ModelOnly" style="color:#e07a6a; font-size:13px; margin-bottom:20px;"></div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="form-field" style="margin-bottom:28px;">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-input" autocomplete="email" autofocus />
                <span asp-validation-for="Email" style="color:#e07a6a; font-size:12px;"></span>
            </div>

            <div class="form-field" style="margin-bottom:36px;">
                <label asp-for="Clave" class="form-label">Contraseña</label>
                <input asp-for="Clave" type="password" class="form-input" autocomplete="current-password" />
                <span asp-validation-for="Clave" style="color:#e07a6a; font-size:12px;"></span>
            </div>

            <button type="submit" class="btn-primary" style="width:100%; padding:18px;">Ingresar</button>
        </form>

        <p style="text-align:center; margin-top:28px; font-size:13px;">
            <a href="/" style="color:var(--text-dim); text-decoration:none;">← Volver al inicio</a>
        </p>
    </div>
</section>