@model FigaroBarbershop.Models.LoginView
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Figaro — Iniciar sesión</title>
    <link rel="stylesheet" href="~/css/tailwind-output.css" asp-append-version="true" />
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
    <div class="bg-white shadow rounded-lg p-8 w-full max-w-sm">
        <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Figaro Barbershop</h1>

        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4"></div>

        <form asp-action="Login" method="post" class="space-y-4">
            <div>
                <label asp-for="Email" class="block text-sm text-gray-600 mb-1"></label>
                <input asp-for="Email" class="w-full border rounded px-3 py-2" autofocus />
                <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
            </div>

            <div>
                <label asp-for="Clave" class="block text-sm text-gray-600 mb-1">Contraseña</label>
                <input asp-for="Clave" type="password" class="w-full border rounded px-3 py-2" />
                <span asp-validation-for="Clave" class="text-red-500 text-xs"></span>
            </div>

            <button type="submit" class="w-full bg-gray-900 text-white py-2 rounded hover:bg-gray-700">
                Ingresar
            </button>
        </form>
    </div>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>