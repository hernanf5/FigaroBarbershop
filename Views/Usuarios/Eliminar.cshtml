@model FigaroBarbershop.Models.Usuario

<div class="max-w-lg mx-auto px-6 py-8">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Dar de baja usuario</h1>
    <p class="text-gray-700">¿Confirmás que querés dar de baja a <strong>@Model.Nombre @Model.Apellido</strong>?</p>

    <form asp-action="Eliminar" asp-route-id="@Model.IdUsuario" method="post" class="flex gap-2 mt-4">
        <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">Confirmar baja</button>
        <a asp-action="Index" class="border px-4 py-2 rounded text-gray-600 hover:bg-gray-50">Cancelar</a>
    </form>
</div>