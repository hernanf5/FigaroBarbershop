@model IList<FigaroBarbershop.Models.Usuario>

<div class="max-w-4xl mx-auto px-6 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Usuarios</h1>
        <a asp-action="Create" class="bg-gray-900 text-white text-sm px-4 py-2 rounded hover:bg-gray-700">Nuevo usuario</a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="bg-green-50 text-green-700 border border-green-200 rounded px-4 py-2 mb-4 text-sm">@TempData["Mensaje"]</div>
    }

    <table class="w-full text-sm border-collapse">
        <thead>
            <tr class="text-left text-gray-500 border-b">
                <th class="py-2">Nombre</th>
                <th class="py-2">Email</th>
                <th class="py-2">Rol</th>
                <th class="py-2"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr class="border-b">
                <td class="py-2">@u.Nombre @u.Apellido</td>
                <td class="py-2">@u.Email</td>
                <td class="py-2">
                    <span class="text-xs px-2 py-1 rounded @(u.Rol == "Administrador" ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700")">
                        @u.Rol
                    </span>
                </td>
                <td class="py-2 text-right">
                    <a asp-action="Eliminar" asp-route-id="@u.IdUsuario" class="text-red-600 hover:underline">Dar de baja</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @{
        int paginaActual = ViewBag.PaginaActual;
        int totalPaginas = ViewBag.TotalPaginas;
    }
    <div class="flex gap-2 mt-4 text-sm">
        @for (int p = 1; p <= totalPaginas; p++)
        {
            <a asp-action="Index" asp-route-pagina="@p" class="px-3 py-1 rounded border @(p == paginaActual ? "bg-gray-900 text-white" : "bg-white text-gray-600")">@p</a>
        }
    </div>
</div>