@model FigaroBarbershop.Models.Usuario

<div class="max-w-lg mx-auto px-6 py-8">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Nuevo usuario</h1>

    <form asp-action="Create" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

        <div>
            <label asp-for="Nombre" class="block text-sm text-gray-600 mb-1"></label>
            <input asp-for="Nombre" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="Nombre" class="text-red-500 text-xs"></span>
        </div>

        <div>
            <label asp-for="Apellido" class="block text-sm text-gray-600 mb-1"></label>
            <input asp-for="Apellido" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="Apellido" class="text-red-500 text-xs"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm text-gray-600 mb-1"></label>
            <input asp-for="Email" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
        </div>

        <div>
            <label asp-for="Clave" class="block text-sm text-gray-600 mb-1">Contraseña</label>
            <input asp-for="Clave" type="password" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="Clave" class="text-red-500 text-xs"></span>
        </div>

        <div>
            <label asp-for="Rol" class="block text-sm text-gray-600 mb-1"></label>
            <select asp-for="Rol" class="w-full border rounded px-3 py-2">
                <option value="Barbero">Barbero</option>
                <option value="Administrador">Administrador</option>
            </select>
        </div>

        <div class="flex gap-2 pt-2">
            <button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-700">Guardar</button>
            <a asp-action="Index" class="border px-4 py-2 rounded text-gray-600 hover:bg-gray-50">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}