@model FigaroBarbershop.Models.Servicio

<div class="container">
    <h1 class="text-2xl font-bold mb-6">Nuevo servicio</h1>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-group">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="form-input" />
            <span asp-validation-for="Nombre" class="text-red-500"></span>
        </div>

        <div class="form-group">
            <label asp-for="DuracionMinutos"></label>
            <input asp-for="DuracionMinutos" type="number" class="form-input" />
            <span asp-validation-for="DuracionMinutos" class="text-red-500"></span>
        </div>

        <div class="form-group">
            <label asp-for="Precio"></label>
            <input asp-for="Precio" type="number" step="0.01" class="form-input" />
            <span asp-validation-for="Precio" class="text-red-500"></span>
        </div>

        <button type="submit" class="btn-primary">Guardar</button>
        <a asp-action="Index" class="btn-outline">Cancelar</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}