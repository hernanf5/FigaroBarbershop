<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FigaroBarbershop</title>
    <link rel="stylesheet" href="~/css/tailwind-output.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-gray-900">
    <header class="bg-white border-b shadow-sm">
        <nav class="max-w-6xl mx-auto px-6 py-3 flex flex-wrap items-center gap-x-6 gap-y-2">
            <a class="font-semibold text-lg" asp-area="" asp-controller="Home" asp-action="Index">FigaroBarbershop</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm flex-1">
                    <a class="hover:underline" asp-controller="Turnos" asp-action="Index">Turnos</a>
                    <a class="hover:underline" asp-controller="Agenda" asp-action="Index">Agenda</a>
                    <a class="hover:underline" asp-controller="Servicios" asp-action="Index">Servicios</a>
                    <a class="hover:underline" asp-controller="Productos" asp-action="Index">Productos</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="hover:underline" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                    }
                </div>

                <div class="flex items-center gap-3 text-sm">
                    @{
                        var avatar = User.FindFirst("AvatarUrl")?.Value;
                        var nombre = User.FindFirst("NombreCompleto")?.Value ?? User.Identity!.Name;
                    }
                    @if (!string.IsNullOrEmpty(avatar))
                    {
                        <img src="@avatar" alt="" class="w-8 h-8 rounded-full object-cover" />
                    }
                    <a class="hover:underline" asp-controller="Usuarios" asp-action="Perfil">@nombre</a>
                    <form asp-controller="Usuarios" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="text-red-700 hover:underline">Salir</button>
                    </form>
                </div>
            }
            else
            {
                <div class="flex-1"></div>
                <a class="text-sm hover:underline" asp-controller="Usuarios" asp-action="Login">Ingresar</a>
            }
        </nav>
    </header>

    <main role="main" class="flex-1 max-w-6xl w-full mx-auto px-6 py-6">
        @RenderBody()
    </main>

    <footer class="border-t bg-white text-gray-500 text-sm">
        <div class="max-w-6xl mx-auto px-6 py-4">
            &copy; 2026 - FigaroBarbershop
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>