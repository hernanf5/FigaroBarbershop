<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Figaro Barbershop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/figaro.css" asp-append-version="true" />
</head>
<body>
    <nav>
        <a class="nav-logo" href="/"><span>F</span>igaro</a>
        <div class="nav-links">
            <a asp-controller="Usuarios" asp-action="Login">Ingresar</a>
        </div>
    </nav>

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>